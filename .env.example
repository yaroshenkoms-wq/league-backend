# Firebase Admin: содержимое serviceAccountKey.json одной строкой
SERVICE_ACCOUNT=

# Ключ API-Football (dashboard.api-football.com)
API_FOOTBALL_KEY=

# Секрет для /api/check и /api/refresh-results (заголовок x-admin-key)
ADMIN_KEY=

PORT=3000

# Автосинхронизация календаря и результатов (каждые 30 минут); false — отключить
SYNC_ENABLED=true

# Число прокси перед сервером: на Render 1. Нужно, чтобы лимиты запросов считались по IP клиента
TRUST_PROXY=1

# Сколько последних резервных копий хранить (backup.js)
BACKUP_KEEP=30
